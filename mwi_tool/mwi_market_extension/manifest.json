{
  "manifest_version": 3,
  "name": "MWI Market Scanner",
  "version": "1.1",
  "description": "Captura pre\u00e7os do Market do Milky Way Idle e envia para o MWI Tool.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://milkywayidle.com/*",
    "https://www.milkywayidle.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://milkywayidle.com/*",
        "https://www.milkywayidle.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}